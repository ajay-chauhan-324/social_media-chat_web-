# ─────────────────────────────────────────────────────────────
#  ArtROOT Chat — Server Environment
#  Copy this file to `.env` and fill in real values.
#  Everything here has a safe fallback so the app runs without
#  external accounts (see src/config/env.js). Add real keys anytime.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — MongoDB Atlas or local. Falls back to local mongodb if unset.
# Atlas example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/artroot_chat
# Database name — applied even when the Atlas SRV string omits one.
MONGO_DB_NAME=artroot_chat

# JWT — CHANGE THESE SECRETS IN PRODUCTION
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google Gemini — real AI responses when set; graceful mock responses when empty.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary — real uploads when set; local ./uploads storage when empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) — real emails when set; logged to console when empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ArtROOT Chat <no-reply@artroot.chat>"
